# Copiar a .env y completar. El archivo .env NO se sube a git.
#
#   cp .env.example .env

# --- Analista IA (Google AI Studio) ---
GEMINI_API_KEY=tu_clave_de_gemini_aqui
GEMINI_MODEL=gemini-flash-lite-latest
# Segundos de espera maxima a Gemini antes de rendirse
GEMINI_TIMEOUT=20

# --- API ---
HOST=127.0.0.1
PORT=8000
# Dominios autorizados, separados por coma. Usar "*" solo en desarrollo.
CORS_ORIGINS=*

# --- Base de datos ---
NOTAMS_DB=sistema_notams.db

# --- Extractor ---
NOTAMS_URL=https://www.aerocivil.gov.co/publicaciones/3708/listas-de-verificacion-y-listas-de-notam-validos/
# Minimo de NOTAMs para considerar valida una extraccion
NOTAMS_MINIMO=50
# Caida porcentual maxima tolerada frente a la extraccion anterior
NOTAMS_CAIDA_MAX_PCT=50
NOTAMS_INTENTOS=3
# Minutos de antiguedad a partir de los cuales /health pasa a "degradado".
NOTAMS_MAX_EDAD_MIN=45
NOTAMS_ESPERA=10
NOTAMS_TIMEOUT=30

# --- METAR / TAF (AVWX) ---
# Se consulta desde el servidor: el token nunca llega al navegador.
AVWX_TOKEN=tu_token_de_avwx_aqui
AVWX_TIMEOUT=15
# Segundos que se guarda cada reporte. 0 lo desactiva.
AVWX_CACHE=60
